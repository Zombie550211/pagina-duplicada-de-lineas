# Copia este archivo a .env.local y rellena los valores.
# .env.local NUNCA se sube al repositorio.
#
# La captacion de leads solo funciona en local: en produccion /api/contact
# devuelve 404 a proposito.

# Clave de API de Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Buzon que recibe los leads del formulario.
LEAD_TO_EMAIL=leads@tu-dominio.com

# Remitente. En produccion exige un dominio verificado en Resend;
# onboarding@resend.dev solo entrega al correo dueno de la cuenta.
LEAD_FROM_EMAIL=Lineas Moviles <leads@tu-dominio.com>
